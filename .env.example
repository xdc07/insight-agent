# 复制成 .env 再填，只填这两行带“必填”的值，其余不动就能跑。
# .env 千万别提交到 Git，仓库的 .gitignore 已经把它忽略了。

# 对外端口：浏览器打开 http://localhost:8080，改这里就换端口。
APP_PORT=8080

# 本机调试用的端口，只绑 127.0.0.1，外面连不进来。
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# 数据库
DB_NAME=data_agent
DB_USER=root
DB_PASSWORD=必填：换一个强密码，不要用你本地那个弱密码

# DeepSeek（必填）
DEEPSEEK_API_KEY=必填：sk-开头的你自己的 Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

REDIS_DATABASE=0

# ---- 下面这两组只在“不用 docker-compose、直接 java -jar 跑”时才用 ----
# compose 模式下不用填，app 容器里已经固定成 mysql / redis。
# DB_HOST=localhost
# DB_PORT=3306
# REDIS_HOST=localhost
# REDIS_PORT=6379
